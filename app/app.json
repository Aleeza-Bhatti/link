{
  "expo": {
    "name": "Link & Sync",
    "slug": "link-sync",
    "scheme": "linksync",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Link & Sync to access your photos to set a profile picture."
        }
      ],
      "expo-web-browser"
    ],
    "ios": {
      "bundleIdentifier": "com.aleezabhatti.linksync",
      "buildNumber": "3",
      "supportsTablet": true,
      "icon": "./assets/icon.png",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Allow Link & Sync to access your photos to set a profile picture.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "extra": {
      "eas": {
        "projectId": "387d8a20-5eaf-4c4a-97c4-9829665d6841"
      }
    }
  }
}